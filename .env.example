# Dominio definitivo, senza barra finale (sitemap, robots, link canonici, anteprime social)
NEXT_PUBLIC_SITE_URL=https://belvedere35.it
# Chiave di web3forms.com: senza chiave il modulo apre il programma di posta del visitatore
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# ID del sito su cloud.umami.is: senza ID le statistiche sono disattivate
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Facoltativo: script Umami self-hosted
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Facoltativo: codice di verifica Google Search Console (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
